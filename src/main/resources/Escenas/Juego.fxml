<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<!--
  Escena principal del juego, armada en FXML (patron MVC).

  Arriba (top): un texto con las vidas actuales (solo visual por ahora).
  Centro (center): un contenedor vacio llamado "contenedorTablero" donde el
  controlador inyecta por codigo la grilla del tablero (VistaTablero), porque
  esa grilla es dinamica y cambia en vivo.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Ud.Controlador.JuegoFxmlController"
            style="-fx-background-color: #1a1a28;">
    <top>
        <Label fx:id="etiquetaVidas" text="Vidas: -"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <StackPane fx:id="contenedorTablero"/>
    </center>
</BorderPane>
